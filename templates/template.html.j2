<!DOCTYPE html>
<html lang="{{ document_metadata.language }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="{{ document_metadata.author }}">
    <meta name="keywords" content="{{ document_metadata.keywords | join(', ') }}">
    <meta name="language" content="{{ document_metadata.language }}">
    <meta name="description" content="{{ document_metadata.description }}">
    <title>{{ document_metadata.title }}</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="fonts/fonts.css">
</head>

<body>
    <header>
        <h1>{{ resume_data.personal_info.name }}</h1>
        <div class="contact-info">
            <span>{{ resume_data.personal_info.location }}</span> ❖
            <span>{{ resume_data.personal_info.email }}</span>
            {% if resume_data.personal_info.phone %}
            ❖ <span>{{ resume_data.personal_info.phone }}</span>
            {% endif %}
        </div>
        {% if resume_data.personal_info.linkedin or resume_data.personal_info.github %}
        <div class="links">
            {% if resume_data.personal_info.linkedin %}
            <a href="https://www.{{ resume_data.personal_info.linkedin }}">{{ resume_data.personal_info.linkedin }}</a>
            {% endif %}
            {% if resume_data.personal_info.github %}
            ❖ <a href="https://{{ resume_data.personal_info.github }}">{{ resume_data.personal_info.github }}</a>
            {% endif %}
        </div>
        {% endif %}
    </header>
    <section id="statement">
        <p>{{ resume_data.statement }}</p>
    </section>
    <section id="skills">
        <h2>Technical Skills</h2>
        <div class="skills-entries">
            {% for skill in resume_data.skill_sections %}
            <div class="skill">
                <h3>{{ skill.title }}</h3>
                <p>{{ skill.skills }}</p>
            </div>
            {% endfor %}
        </div>
    </section>
    <br>
    <section id="experience">
        <h2>Work Experience</h2>
        {% for entry in resume_data.experience %}
        <div class="entry {% if loop.last %}page-break{% endif %}">
            <div class="entry-header">
                <div class="split">
                    <h3>{{ entry.title }}</h3>
                    <span>{{ entry.start_date }}{% if entry.end_date %} – {{ entry.end_date }}{% else %} – Present{%
                        endif %}</span>
                </div>
                <div class="split">
                    <span><i>{{ entry.company }}</i></span>
                    <span>{{ entry.location }}</span>
                </div>
            </div>
            <ul>
                {% for bullet in entry.description_bullets %}
                <li>{{ bullet}}</li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </section>
    <br>
    <section id="projects">
        <h2>Projects</h2>
        {% for project in resume_data.projects %}
        <div class="entry">
            <div class="entry-header">
                <div class="split">
                    <h3>{{ project.title }}</h3>
                    {% if project.link or project.timeframe %}
                    <span>
                        {% if project.timeframe %}
                        {{ project.timeframe }}
                        {% endif %}
                        {% if project.link %}
                        | <a href="{{ project.link.url }}">{{ project.link.text }}</a>
                        {% endif %}
                    </span>
                    {% endif %}
                </div>
                {% if project.subtitle %}
                <span class="subtitle">{{ project.subtitle }}</span>
                {% endif %}
            </div>
            <ul>
                {% for bullet in project.description_bullets %}
                <li>{{ bullet }}</li>
                {% endfor %}
            </ul>
            <span class="project-technologies">Technologies: {{ project.technologies | join(', ') }}</span>
        </div>
        {% endfor %}
    </section>
    <br>
    <section id="education">
        <h2>Education</h2>
        {% for education in resume_data.education %}
        <div class="entry">
            <div class="entry-header">
                <div class="split">
                    <h3>{{ education.institution }}</h3>
                    <span>{{ education.completion_date }}</span>
                </div>
                <span class="subtitle">{{ education.degree }} {% if education.gpa %} | GPA: {{ education.gpa }}{% endif
                    %}{% if education.honors %} | {{ education.honors | join(' | ') }}{% endif %}</span>
            </div>
            {% if education.description %}
            <p>{{ education.description }}</p>
            {% endif %}
        </div>
        {% endfor %}
</body>

</html>
